{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/home", "destination": "/index.html" },
    { "source": "/(dashboard|accounts|income|outcome|projected-income|projected-outcome|report)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
